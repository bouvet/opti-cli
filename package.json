{
	"name": "@bouvet/opti-cli",
	"version": "2.0.8",
	"main": "./src/cli.mjs",
	"type": "module",
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/bouvet/opti-cli.git"
	},
	"scripts": {
		"commands:add": "node ./scripts/generate-command.mjs",
		"cli:install": "pnpm add -g .",
		"cli:uninstall": "pnpm remove -g @bouvet/opti-cli",
		"publish:jsr": "npx jsr publish",
		"lint": "pnpm biome check --write",
		"lint:check": "pnpm biome check --files-ignore-unknown=true --no-errors-on-unmatched",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "husky"
	},
	"lint-staged": {
		"*": [
			"pnpm lint:check"
		]
	},
	"bin": {
		"opti": "./src/cli.mjs"
	},
	"imports": {
		"#core/*": "./src/core/*",
		"#helpers/*": "./src/helpers/*",
		"#bin/*": "./bin/*",
		"#cli": "./src/cli.mjs"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"dependencies": {
		"@inquirer/prompts": "7.2.0",
		"app-root-path": "3.1.0",
		"commander": "12.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "22.13.14",
		"husky": "9.1.7",
		"lint-staged": "17.5.1",
		"prettier": "3.4.2",
		"prettier-eslint": "16.4.2",
		"vitest": "^5.0.1"
	},
	"volta": {
		"node": "22.14.0"
	},
	"packageManager": "pnpm@12.4.1"
}
