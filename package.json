{
  "name": "@bouvet/opti-cli",
  "version": "2.0.3",
  "main": "./src/cli.mjs",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bouvet/opti-cli.git"
  },
  "scripts": {
    "commands:add": "node ./scripts/generate-command.mjs",
    "cli:install": "pnpm add -g .",
    "cli:uninstall": "pnpm remove -g @bouvet/opti-cli",
    "publish:jsr": "npx jsr publish"
  },
  "bin": {
    "opti": "./src/cli.mjs"
  },
  "imports": {
    "#core/*": "./src/core/*",
    "#helpers/*": "./src/helpers/*",
    "#bin/*": "./bin/*",
    "#cli": "./src/cli.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@inquirer/prompts": "7.2.0",
    "app-root-path": "3.1.0",
    "commander": "12.1.0"
  },
  "devDependencies": {
    "@types/node": "22.13.14",
    "prettier": "3.4.2",
    "prettier-eslint": "16.4.2"
  },
  "volta": {
    "node": "22.14.0"
  },
  "packageManager": "pnpm@12.4.1"
}